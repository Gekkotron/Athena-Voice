# Optional docker-compose settings. Copy to .env and edit; every value
# has a working default, so an empty/absent .env is fine.
#
#   cp .env.example .env

# Admin web UI port on the host (container always listens on 8080).
#ATHENA_ADMIN_PORT=9000

# Profiles to activate for EVERY compose command, so you don't have to
# remember `--profile voice` on each one. Set this and plain `./update.sh`,
# `docker compose pull` and `docker compose up -d` all cover the workers —
# without it, `pull` fetches images only for the default profile and an
# updated worker image is silently never downloaded.
#COMPOSE_PROFILES=voice

# --- voice profile (docker compose --profile voice) -----------------
# Broker the STT/TTS workers connect to. Default "mosquitto" is the
# bundled broker service; set your LAN broker's address (or "host.docker
# .internal" for one on the Docker host) when using --profile voice
# without --profile broker. This should match [mqtt] host in
# athena.docker.toml.
#ATHENA_MQTT_HOST=192.168.1.2
#ATHENA_MQTT_PORT=1883

# Topic namespace; must equal [mqtt] topic_root in athena.docker.toml and
# the `topic_root` in every satellite's config.
#ATHENA_TOPIC_ROOT=assist

# Model filenames inside ./models (mounted read-only at /models).
#ATHENA_WHISPER_MODEL=ggml-base.bin
#ATHENA_PIPER_VOICE=fr_FR-siwis-medium.onnx

# Provider name the tts-worker registers under; must equal
# [providers] tts = { mqtt_tts = { name = "..." } }.
#ATHENA_TTS_NAME=say
